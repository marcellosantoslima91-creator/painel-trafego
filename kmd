} from "lucide-react";

const STAGES = [
  { id: "novo", label: "Novo Lead" },
  { id: "contato", label: "Contato Feito" },
  { id: "diagnostico", label: "Diagnóstico Agendado" },
  { id: "proposta", label: "Proposta Enviada" },
  { id: "negociacao", label: "Negociação" },
  { id: "fechado", label: "Fechado" },
  { id: "perdido", label: "Perdido" },
];

const ORIGENS = [
  { id: "whatsapp", label: "WhatsApp", icon: MessageCircle, color: "#5FD068" },
  { id: "anuncio", label: "Anúncio", icon: Megaphone, color: "#F2B705" },
  { id: "indicacao", label: "Indicação", icon: Users, color: "#3EC1D3" },
];

const FOLLOWUP_TEMPLATES = {
  novo: (nome) => `Oi ${nome}, tudo bem? Recebi seu contato sobre gestão de tráfego pago e queria entender melhor seu momento atual. Podemos conversar?`,
  contato: (nome) => `Oi ${nome}! Ainda por aqui pra seguirmos com o diagnóstico do seu negócio. Quando fica bom pra você?`,
  diagnostico: (nome) => `Oi ${nome}, confirmando nosso diagnóstico — fico no aguardo!`,
  proposta: (nome) => `Oi ${nome}, só confirmando se você já teve a chance de olhar a proposta que te enviei. Fico à disposição para dúvidas!`,
  negociacao: (nome) => `Oi ${nome}, vamos fechar os últimos detalhes? Consigo ajustar o que for necessário pra fazer sentido pra você.`,
};

const FOLLOWUP_OPTIONS = [
  { label: "Em 2 horas", ms: 2 * 60 * 60 * 1000 },
  { label: "Amanhã", ms: 24 * 60 * 60 * 1000 },
  { label: "Em 3 dias", ms: 3 * 24 * 60 * 60 * 1000 },
  { label: "Em 1 semana", ms: 7 * 24 * 60 * 60 * 1000 },
];

const currency = (n) => new Intl.NumberFormat("pt-PT", { style: "currency", currency: "EUR" }).format(n || 0);
const formatDate = (iso) => (iso ? new Date(iso).toLocaleDateString("pt-PT") : "");
const formatDateTime = (iso) =>
  iso ? new Date(iso).toLocaleDateString("pt-PT") + " às " + new Date(iso).toLocaleTimeString("pt-PT", { hour: "2-digit", minute: "2-digit" }) : "";
const onlyDigits = (s) => (s || "").replace(/\D/g, "");
const addMonths = (dateStr, months) => {
  const d = new Date(dateStr);
  d.setMonth(d.getMonth() + months);
  return d.toISOString().slice(0, 10);
};
const genParcelasArr = (valor, numParcelas, primeiraData) => {
  const n = Math.max(1, parseInt(numParcelas) || 1);
  const base = Math.floor((valor / n) * 100) / 100;
  const resto = Math.round((valor - base * n) * 100) / 100;
  const arr = [];
  for (let i = 0; i < n; i++) {
    arr.push({
      numero: i + 1,
      valor: i === n - 1 ? Math.round((base + resto) * 100) / 100 : base,
      vencimento: addMonths(primeiraData, i),
      pago: false,
    });
  }
  return arr;
};

const emptyForm = { nome: "", telefone: "", origem: "whatsapp", valor: "", notas: "" };

export default function App() {
  const [session, setSession] = useState(null);
  const [authLoading, setAuthLoading] = useState(true);

  useEffect(() => {
    supabase.auth.getSession().then(({ data }) => {
      setSession(data.session);
      setAuthLoading(false);
    });
    const { data: listener } = supabase.auth.onAuthStateChange((_event, sess) => setSession(sess));
    return () => listener.subscription.unsubscribe();
  }, []);

  if (authLoading) {
    return <CenteredMsg text="Carregando…" />;
  }
  if (!session) {
    return <AuthScreen />;
  }
  return <CRM session={session} />;
}

function CenteredMsg({ text }) {
  return (
    <div style={{ minHeight: "100vh", background: "#14171C", display: "flex", alignItems: "center", justifyContent: "center" }}>
      <span style={{ color: "#8B92A0", fontFamily: "system-ui, sans-serif" }}>{text}</span>
    </div>
  );
}

function AuthScreen() {
  const [mode, setMode] = useState("signin");
  const [email, setEmail] = useState("");
  const [password, setPassword] = useState("");
  const [error, setError] = useState("");
  const [info, setInfo] = useState("");
  const [busy, setBusy] = useState(false);

  const submit = async (e) => {
    e.preventDefault();
    setError("");
    setInfo("");
    setBusy(true);
    try {
      if (mode === "signin") {
        const { error } = await supabase.auth.signInWithPassword({ email, password });
        if (error) setError(error.message);
      } else {
        const { error } = await supabase.auth.signUp({ email, password });
        if (error) setError(error.message);
        else setInfo("Conta criada! Verifique seu e-mail para confirmar, depois faça login.");
      }
    } finally {
      setBusy(false);
    }
  };

  return (
    <div style={{ minHeight: "100vh", background: "#14171C", color: "#E8E6E1", fontFamily: "system-ui, sans-serif", display: "flex", alignItems: "center", justifyContent: "center", padding: 16 }}>
      <form onSubmit={submit} style={{ background: "#1C2028", border: "1px solid #2A2F38", borderRadius: 14, padding: 28, width: "100%", maxWidth: 360 }}>
        <h1 style={{ fontSize: 22, fontWeight: 700, margin: "0 0 4px" }}>Painel de Tráfego</h1>
        <p style={{ color: "#8B92A0", fontSize: 13, margin: "0 0 20px" }}>
          {mode === "signin" ? "Entre com sua conta" : "Crie sua conta"}
        </p>
        <label style={labelStyle}>E-mail</label>
        <input style={inputStyle} type="email" required value={email} onChange={(e) => setEmail(e.target.value)} />
        <label style={labelStyle}>Senha</label>
        <input style={inputStyle} type="password" required minLength={6} value={password} onChange={(e) => setPassword(e.target.value)} />
        {error && <div style={{ color: "#F26D6D", fontSize: 12.5, marginTop: 10 }}>{error}</div>}
        {info && <div style={{ color: "#5FD068", fontSize: 12.5, marginTop: 10 }}>{info}</div>}
        <button disabled={busy} type="submit" style={{ ...primaryBtn, opacity: busy ? 0.6 : 1 }}>
          {mode === "signin" ? "Entrar" : "Criar conta"}
        </button>
        <button
          type="button"
          onClick={() => { setMode(mode === "signin" ? "signup" : "signin"); setError(""); setInfo(""); }}
          style={{ background: "none", border: "none", color: "#8B92A0", fontSize: 12.5, marginTop: 12, cursor: "pointer", width: "100%" }}
        >
          {mode === "signin" ? "Não tem conta? Criar uma" : "Já tem conta? Entrar"}
        </button>
      </form>
    </div>
  );
}

function CRM({ session }) {
  const userId = session.user.id;
  const [leads, setLeads] = useState([]);
  const [loaded, setLoaded] = useState(false);
  const [tab, setTab] = useState("pipeline");
  const [modalOpen, setModalOpen] = useState(false);
  const [editingId, setEditingId] = useState(null);
  const [form, setForm] = useState(emptyForm);
  const [dragId, setDragId] = useState(null);
  const [error, setError] = useState("");
  const [proposalLead, setProposalLead] = useState(null);
  const [parcelaForms, setParcelaForms] = useState({});

  const fetchLeads = useCallback(async () => {
    const { data, error } = await supabase
      .from("leads")
      .select("*, parcelas(*)")
      .order("created_at", { ascending: true });
    if (error) setError("Erro ao carregar: " + error.message);
    else setLeads(data || []);
    setLoaded(true);
  }, []);

  useEffect(() => { fetchLeads(); }, [fetchLeads]);

  const saveLead = async () => {
    if (!form.nome.trim()) return;
    const payload = { ...form, valor: parseFloat(form.valor) || 0 };
    if (editingId) {
      const { error } = await supabase.from("leads").update(payload).eq("id", editingId);
      if (error) setError(error.message);
    } else {
      const { error } = await supabase.from("leads").insert({ ...payload, user_id: userId, stage: "novo" });
      if (error) setError(error.message);
    }
    setModalOpen(false);
    fetchLeads();
  };

  const deleteLead = async (id) => {
    const { error } = await supabase.from("leads").delete().eq("id", id);
    if (error) setError(error.message);
    fetchLeads();
  };

  const moveLead = async (id, stage) => {
    const { error } = await supabase.from("leads").update({ stage }).eq("id", id);
    if (error) setError(error.message);
    fetchLeads();
  };

  const setFollowUp = async (id, ms) => {
    const next = ms ? new Date(Date.now() + Number(ms)).toISOString() : null;
    const { error } = await supabase.from("leads").update({ next_follow_up: next }).eq("id", id);
    if (error) setError(error.message);
    fetchLeads();
  };

  const gerarParcelas = async (lead) => {
    const pf = parcelaForms[lead.id] || { num: 1, data: new Date().toISOString().slice(0, 10) };
    const arr = genParcelasArr(lead.valor, pf.num, pf.data).map((p) => ({ ...p, lead_id: lead.id }));
    const { error } = await supabase.from("parcelas").insert(arr);
    if (error) setError(error.message);
    fetchLeads();
  };

  const togglePago = async (parcelaId, pagoAtual) => {
    const { error } = await supabase.from("parcelas").update({ pago: !pagoAtual }).eq("id", parcelaId);
    if (error) setError(error.message);
    fetchLeads();
  };

  const updateVencimento = async (parcelaId, novaData) => {
    const { error } = await supabase.from("parcelas").update({ vencimento: novaData }).eq("id", parcelaId);
    if (error) setError(error.message);
    fetchLeads();
  };

  const openNew = () => { setForm(emptyForm); setEditingId(null); setModalOpen(true); };
  const openEdit = (lead) => {
    setForm({ nome: lead.nome, telefone: lead.telefone || "", origem: lead.origem, valor: String(lead.valor || ""), notas: lead.notas || "" });
    setEditingId(lead.id);
    setModalOpen(true);
  };

  const pipelineAberto = leads.filter((l) => !["fechado", "perdido"].includes(l.stage)).reduce((s, l) => s + (l.valor || 0), 0);
  const receitaFechada = leads.filter((l) => l.stage === "fechado").reduce((s, l) => s + (l.valor || 0), 0);

  const followUpsPendentes = useMemo(() => {
    const now = Date.now();
    return leads
      .filter((l) => l.next_follow_up && new Date(l.next_follow_up).getTime() <= now && !["fechado", "perdido"].includes(l.stage))
      .sort((a, b) => new Date(a.next_follow_up) - new Date(b.next_follow_up));
  }, [leads]);

  const leadsFechados = leads.filter((l) => l.stage === "fechado");
  const totalRecebido = leadsFechados.reduce((s, l) => s + (l.parcelas || []).filter((p) => p.pago).reduce((s2, p) => s2 + p.valor, 0), 0);
  const totalAReceber = leadsFechados.reduce((s, l) => s + (l.parcelas || []).filter((p) => !p.pago).reduce((s2, p) => s2 + p.valor, 0), 0);
  const totalAtrasado = leadsFechados.reduce(
    (s, l) => s + (l.parcelas || []).filter((p) => !p.pago && new Date(p.vencimento).getTime() < Date.now()).reduce((s2, p) => s2 + p.valor, 0),
    0
  );

  if (!loaded) return <CenteredMsg text="Carregando…" />;

  return (
    <div style={{ minHeight: "100vh", background: "#14171C", color: "#E8E6E1", fontFamily: "system-ui, sans-serif", padding: "20px 16px 60px" }}>
      <style>{`
        * { box-sizing: border-box; }
        button:focus-visible, input:focus-visible, textarea:focus-visible, select:focus-visible { outline: 2px solid #F2B705; outline-offset: 2px; }
        @media print {
          body * { visibility: hidden; }
          .print-area, .print-area * { visibility: visible; }
          .print-area { position: absolute; top: 0; left: 0; width: 100%; }
          .no-print { display: none !important; }
        }
      `}</style>

      <div style={{ maxWidth: 1200, margin: "0 auto 20px" }} className="no-print">
        <div style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-start", flexWrap: "wrap", gap: 16 }}>
          <div>
            <h1 style={{ fontWeight: 700, fontSize: 28, margin: 0, letterSpacing: "-0.02em" }}>Painel de Tráfego</h1>
            <p style={{ color: "#8B92A0", margin: "4px 0 0", fontSize: 14 }}>{session.user.email}</p>
          </div>
          <div style={{ display: "flex", gap: 8 }}>
            <button onClick={openNew} style={{ ...primaryBtn, width: "auto", marginTop: 0, display: "flex", alignItems: "center", gap: 6 }}>
              <Plus size={16} /> Novo Lead
            </button>
            <button onClick={() => supabase.auth.signOut()} style={{ background: "none", border: "1px solid #2A2F38", color: "#8B92A0", borderRadius: 8, padding: "0 12px", cursor: "pointer" }}>
              <LogOut size={15} />
            </button>
          </div>
        </div>

        <div style={{ display: "flex", gap: 8, marginTop: 18 }}>
          {[{ id: "pipeline", label: "Pipeline" }, { id: "financeiro", label: "Financeiro" }].map((t) => (
            <button key={t.id} onClick={() => setTab(t.id)} style={{ background: tab === t.id ? "#20242C" : "transparent", color: tab === t.id ? "#F2B705" : "#8B92A0", border: "1px solid " + (tab === t.id ? "#2A2F38" : "transparent"), borderRadius: 8, padding: "7px 14px", fontSize: 13, fontWeight: 600, cursor: "pointer" }}>
              {t.label}
            </button>
          ))}
        </div>

        <div style={{ display: "flex", gap: 12, marginTop: 18, flexWrap: "wrap" }}>
          {tab === "pipeline" ? (
            <>
              <SummaryCard icon={TrendingUp} label="PIPELINE EM ABERTO" value={currency(pipelineAberto)} color="#F2B705" />
              <SummaryCard icon={Wallet} label="RECEITA FECHADA" value={currency(receitaFechada)} color="#3EC1D3" />
              <SummaryCard icon={Users} label="LEADS ATIVOS" value={leads.filter((l) => !["fechado", "perdido"].includes(l.stage)).length} />
            </>
          ) : (
            <>
              <SummaryCard icon={CheckCircle2} label="RECEBIDO" value={currency(totalRecebido)} color="#5FD068" />
              <SummaryCard icon={Wallet} label="A RECEBER" value={currency(totalAReceber)} color="#3EC1D3" />
              <SummaryCard icon={AlertTriangle} label="ATRASADO" value={currency(totalAtrasado)} color="#F26D6D" />
            </>
          )}
        </div>
        {error && <div style={{ marginTop: 12, color: "#F26D6D", fontSize: 13 }}>{error}</div>}
      </div>

      {tab === "pipeline" && (
        <>
          {followUpsPendentes.length > 0 && (
            <div className="no-print" style={{ maxWidth: 1200, margin: "0 auto 20px", background: "#20181A", border: "1px solid #3A2226", borderRadius: 12, padding: 14 }}>
              <div style={{ display: "flex", alignItems: "center", gap: 6, fontSize: 13, fontWeight: 600, color: "#F2A05F", marginBottom: 10 }}>
                <Clock size={15} /> Follow-ups pendentes ({followUpsPendentes.length})
              </div>
              <div style={{ display: "flex", flexDirection: "column", gap: 8 }}>
                {followUpsPendentes.map((lead) => {
                  const msg = (FOLLOWUP_TEMPLATES[lead.stage] || FOLLOWUP_TEMPLATES.novo)(lead.nome);
                  const phone = onlyDigits(lead.telefone);
                  return (
                    <div key={lead.id} style={{ display: "flex", justifyContent: "space-between", alignItems: "center", gap: 10, flexWrap: "wrap", background: "#1C1517", borderRadius: 8, padding: "8px 10px" }}>
                      <div style={{ minWidth: 160 }}>
                        <div style={{ fontWeight: 600, fontSize: 13.5 }}>{lead.nome}</div>
                        <div style={{ color: "#8B92A0", fontSize: 11.5 }}>previsto para {formatDateTime(lead.next_follow_up)}</div>
                      </div>
                      {phone ? (
                        <a href={`https://wa.me/${phone}?text=${encodeURIComponent(msg)}`} target="_blank" rel="noopener noreferrer" style={{ background: "#5FD068", color: "#0F1A11", textDecoration: "none", fontSize: 12, fontWeight: 600, padding: "6px 10px", borderRadius: 6, display: "flex", alignItems: "center", gap: 5 }}>
                          <MessageCircle size={13} /> Abrir WhatsApp
                        </a>
                      ) : (
                        <span style={{ color: "#8B92A0", fontSize: 11.5 }}>sem telefone cadastrado</span>
                      )}
                    </div>
                  );
                })}
              </div>
            </div>
          )}

          <div style={{ maxWidth: 1200, margin: "0 auto", display: "flex", gap: 14, overflowX: "auto", paddingBottom: 8 }} className="no-print">
            {STAGES.map((stage) => {
              const stageLeads = leads.filter((l) => l.stage === stage.id);
              const stageValue = stageLeads.reduce((s, l) => s + (l.valor || 0), 0);
              return (
                <div key={stage.id} onDragOver={(e) => e.preventDefault()} onDrop={() => { if (dragId) moveLead(dragId, stage.id); setDragId(null); }} style={{ background: "#181B21", borderRadius: 12, minWidth: 250, flex: "0 0 250px", border: "1px solid #23272F", display: "flex", flexDirection: "column", maxHeight: "72vh" }}>
                  <div style={{ padding: "12px 14px", borderBottom: "1px solid #23272F" }}>
                    <div style={{ fontWeight: 600, fontSize: 13 }}>{stage.label}</div>
                    <div style={{ color: "#8B92A0", fontSize: 12, marginTop: 2 }}>{stageLeads.length} · {currency(stageValue)}</div>
                  </div>
                  <div style={{ padding: 10, overflowY: "auto", flex: 1, display: "flex", flexDirection: "column", gap: 8 }}>
                    {stageLeads.length === 0 && <div style={{ color: "#4A505C", fontSize: 12, padding: "10px 4px" }}>Nenhum lead aqui</div>}
                    {stageLeads.map((lead) => {
                      const origem = ORIGENS.find((o) => o.id === lead.origem) || ORIGENS[0];
                      const OrigemIcon = origem.icon;
                      const pagas = (lead.parcelas || []).filter((p) => p.pago).length;
                      const totalParcelas = (lead.parcelas || []).length;
                      return (
                        <div key={lead.id} draggable onDragStart={() => setDragId(lead.id)} style={{ background: "#20242C", borderRadius: 8, padding: 10, border: "1px solid #2A2F38", cursor: "grab" }}>
                          <div style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-start", gap: 6 }}>
                            <div style={{ fontWeight: 600, fontSize: 13.5 }}>{lead.nome}</div>
                            <div style={{ display: "flex", gap: 4 }}>
                              {lead.valor > 0 && <button onClick={() => setProposalLead(lead)} style={iconBtn}><FileText size={13} /></button>}
                              <button onClick={() => openEdit(lead)} style={iconBtn}><Pencil size={13} /></button>
                              <button onClick={() => deleteLead(lead.id)} style={iconBtn}><Trash2 size={13} /></button>
                            </div>
                          </div>
                          {lead.telefone && <div style={{ display: "flex", alignItems: "center", gap: 4, color: "#8B92A0", fontSize: 12, marginTop: 4 }}><Phone size={11} /> {lead.telefone}</div>}
                          <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginTop: 8 }}>
                            <span style={{ display: "flex", alignItems: "center", gap: 4, fontSize: 11, color: origem.color }}><OrigemIcon size={11} /> {origem.label}</span>
                            {lead.valor > 0 && <span style={{ fontSize: 12.5 }}>{currency(lead.valor)}</span>}
                          </div>
                          {totalParcelas > 0 && <div style={{ fontSize: 11, color: "#8B92A0", marginTop: 4 }}>{pagas}/{totalParcelas} parcelas pagas</div>}
                          <select value={lead.stage} onChange={(e) => moveLead(lead.id, e.target.value)} style={selectSmall}>
                            {STAGES.map((s) => <option key={s.id} value={s.id}>{s.label}</option>)}
                          </select>
                          <select value="" onChange={(e) => { const opt = FOLLOWUP_OPTIONS.find((o) => o.label === e.target.value); if (opt) setFollowUp(lead.id, opt.ms); }} style={{ ...selectSmall, marginTop: 6, color: "#8B92A0" }}>
                            <option value="" disabled>{lead.next_follow_up ? `Follow-up: ${formatDateTime(lead.next_follow_up)}` : "Agendar follow-up"}</option>
                            {FOLLOWUP_OPTIONS.map((o) => <option key={o.label} value={o.label}>{o.label}</option>)}
                          </select>
                        </div>
                      );
                    })}
                  </div>
                </div>
              );
            })}
          </div>
        </>
      )}

      {tab === "financeiro" && (
        <div style={{ maxWidth: 900, margin: "0 auto" }} className="no-print">
          {leadsFechados.length === 0 && (
            <div style={{ color: "#4A505C", fontSize: 13, textAlign: "center", padding: 30 }}>
              Nenhum cliente fechado ainda. Quando um lead for movido para "Fechado", ele aparece aqui pra você organizar as parcelas.
            </div>
          )}
          {leadsFechados.map((lead) => {
            const hasParcelas = (lead.parcelas || []).length > 0;
            const pf = parcelaForms[lead.id] || { num: "1", data: new Date().toISOString().slice(0, 10) };
            return (
              <div key={lead.id} style={{ background: "#1C2028", border: "1px solid #262B34", borderRadius: 10, padding: 16, marginBottom: 12 }}>
                <div style={{ fontWeight: 600, fontSize: 15 }}>{lead.nome}</div>
                <div style={{ color: "#8B92A0", fontSize: 12.5 }}>Valor total: {currency(lead.valor)}</div>
                {!hasParcelas ? (
                  <div style={{ display: "flex", gap: 8, alignItems: "flex-end", flexWrap: "wrap", marginTop: 12 }}>
                    <div>
                      <label style={labelStyle}>Nº de parcelas</label>
                      <input type="number" min="1" style={{ ...inputStyle, width: 90 }} value={pf.num} onChange={(e) => setParcelaForms({ ...parcelaForms, [lead.id]: { ...pf, num: e.target.value } })} />
                    </div>
                    <div>
                      <label style={labelStyle}>1º vencimento</label>
                      <input type="date" style={{ ...inputStyle, width: 150 }} value={pf.data} onChange={(e) => setParcelaForms({ ...parcelaForms, [lead.id]: { ...pf, data: e.target.value } })} />
                    </div>
                    <button onClick={() => gerarParcelas(lead)} style={{ background: "#3EC1D3", color: "#0F1E20", border: "none", borderRadius: 7, padding: "9px 14px", fontWeight: 600, fontSize: 12.5, cursor: "pointer" }}>
                      Gerar parcelas
                    </button>
                  </div>
                ) : (
                  <div style={{ marginTop: 12, display: "flex", flexDirection: "column", gap: 6 }}>
                    {lead.parcelas.map((p) => {
                      const atrasada = !p.pago && new Date(p.vencimento).getTime() < Date.now();
                      return (
                        <div key={p.id} style={{ display: "flex", alignItems: "center", gap: 10, background: "#181B21", borderRadius: 7, padding: "8px 10px", flexWrap: "wrap" }}>
                          <button onClick={() => togglePago(p.id, p.pago)} style={{ background: "none", border: "none", cursor: "pointer", color: p.pago ? "#5FD068" : "#8B92A0", display: "flex" }}>
                            {p.pago ? <CheckCircle2 size={17} /> : <Circle size={17} />}
                          </button>
                          <span style={{ fontSize: 12.5, minWidth: 60 }}>Parcela {p.numero}</span>
                          <span style={{ fontSize: 12.5, minWidth: 90 }}>{currency(p.valor)}</span>
                          <input type="date" value={p.vencimento} onChange={(e) => updateVencimento(p.id, e.target.value)} style={{ ...inputStyle, width: 140, padding: "5px 8px", fontSize: 12 }} />
                          {atrasada && <span style={{ color: "#F26D6D", fontSize: 11, display: "flex", alignItems: "center", gap: 4 }}><AlertTriangle size={12} /> atrasada</span>}
                          {p.pago && <span style={{ color: "#5FD068", fontSize: 11 }}>paga</span>}
                        </div>
                      );
                    })}
                  </div>
                )}
              </div>
            );
          })}
        </div>
      )}

      {modalOpen && (
        <div className="no-print" style={overlayStyle} onClick={() => setModalOpen(false)}>
          <div onClick={(e) => e.stopPropagation()} style={modalStyle}>
            <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 16 }}>
              <h2 style={{ fontSize: 18, margin: 0 }}>{editingId ? "Editar Lead" : "Novo Lead"}</h2>
              <button onClick={() => setModalOpen(false)} style={{ background: "none", border: "none", color: "#8B92A0", cursor: "pointer" }}><X size={18} /></button>
            </div>
            <label style={labelStyle}>Nome</label>
            <input style={inputStyle} value={form.nome} onChange={(e) => setForm({ ...form, nome: e.target.value })} placeholder="Nome do cliente" />
            <label style={labelStyle}>Telefone</label>
            <input style={inputStyle} value={form.telefone} onChange={(e) => setForm({ ...form, telefone: e.target.value })} placeholder="Ex: 351 91 000 0000" />
            <label style={labelStyle}>Origem</label>
            <select style={inputStyle} value={form.origem} onChange={(e) => setForm({ ...form, origem: e.target.value })}>
              {ORIGENS.map((o) => <option key={o.id} value={o.id}>{o.label}</option>)}
            </select>
            <label style={labelStyle}>Valor da proposta (€)</label>
            <input type="number" style={inputStyle} value={form.valor} onChange={(e) => setForm({ ...form, valor: e.target.value })} placeholder="0,00" />
            <label style={labelStyle}>Notas</label>
            <textarea style={{ ...inputStyle, minHeight: 60, resize: "vertical" }} value={form.notas} onChange={(e) => setForm({ ...form, notas: e.target.value })} placeholder="Observações sobre o lead" />
            <button onClick={saveLead} style={primaryBtn}>{editingId ? "Salvar alterações" : "Adicionar lead"}</button>
          </div>
        </div>
      )}

      {proposalLead && (
        <div style={overlayStyle} onClick={() => setProposalLead(null)}>
          <div onClick={(e) => e.stopPropagation()} style={{ background: "#fff", color: "#111", borderRadius: 10, width: "100%", maxWidth: 560, maxHeight: "90vh", overflowY: "auto" }}>
            <div className="print-area" style={{ padding: 36 }}>
              <div style={{ fontSize: 22, fontWeight: 700, marginBottom: 4 }}>Proposta de Serviço</div>
              <div style={{ fontSize: 13, color: "#555", marginBottom: 24 }}>Gestão de Tráfego Pago</div>
              <div style={{ display: "flex", justifyContent: "space-between", fontSize: 13, marginBottom: 20, borderBottom: "1px solid #ddd", paddingBottom: 16 }}>
                <div>
                  <div style={{ color: "#777", fontSize: 11 }}>PARA</div>
                  <div style={{ fontWeight: 600 }}>{proposalLead.nome}</div>
                  {proposalLead.telefone && <div>{proposalLead.telefone}</div>}
                </div>
                <div style={{ textAlign: "right" }}>
                  <div style={{ color: "#777", fontSize: 11 }}>DATA</div>
                  <div>{formatDate(new Date().toISOString())}</div>
                  <div style={{ color: "#777", fontSize: 11, marginTop: 6 }}>VÁLIDA ATÉ</div>
                  <div>{formatDate(new Date(Date.now() + 30 * 24 * 60 * 60 * 1000).toISOString())}</div>
                </div>
              </div>
              <div style={{ fontSize: 13.5, lineHeight: 1.6, marginBottom: 20 }}>
                Proposta de prestação de serviços de gestão de tráfego pago (Meta Ads), incluindo planejamento de campanhas,
                criação e otimização de anúncios, acompanhamento de métricas e relatórios de desempenho.
                {proposalLead.notas ? ` ${proposalLead.notas}` : ""}
              </div>
              <div style={{ background: "#f6f6f6", borderRadius: 8, padding: 16, display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 24 }}>
                <span style={{ fontSize: 13, color: "#555" }}>Investimento total</span>
                <span style={{ fontSize: 20, fontWeight: 700 }}>{currency(proposalLead.valor)}</span>
              </div>
              <div style={{ fontSize: 11.5, color: "#999" }}>Proposta gerada automaticamente pelo Painel de Tráfego.</div>
            </div>
            <div className="no-print" style={{ display: "flex", gap: 8, padding: "0 36px 24px" }}>
              <button onClick={() => window.print()} style={{ ...primaryBtn, marginTop: 0, flex: 1, background: "#14171C", color: "#fff", display: "flex", alignItems: "center", justifyContent: "center", gap: 6 }}>
                <Printer size={15} /> Imprimir / Salvar PDF
              </button>
              <button onClick={() => setProposalLead(null)} style={{ ...primaryBtn, marginTop: 0, flex: 1, background: "#eee", color: "#111" }}>Fechar</button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}

function SummaryCard({ icon: Icon, label, value, color }) {
  return (
    <div style={{ background: "#1C2028", borderRadius: 10, padding: "14px 18px", flex: "1 1 200px", border: "1px solid #262B34" }}>
      <div style={{ display: "flex", alignItems: "center", gap: 8, color: "#8B92A0", fontSize: 12, marginBottom: 6 }}><Icon size={14} /> {label}</div>
      <div style={{ fontSize: 22, fontWeight: 600, color: color || "#E8E6E1" }}>{value}</div>
    </div>
  );
}

const iconBtn = { background: "none", border: "none", color: "#8B92A0", cursor: "pointer", padding: 2 };
const selectSmall = { marginTop: 8, width: "100%", background: "#14171C", color: "#E8E6E1", border: "1px solid #2A2F38", borderRadius: 6, fontSize: 11, padding: "4px 6px" };
const overlayStyle = { position: "fixed", inset: 0, background: "rgba(10,12,15,0.7)", display: "flex", alignItems: "center", justifyContent: "center", padding: 16, zIndex: 50 };
const modalStyle = { background: "#1C2028", borderRadius: 14, padding: 22, width: "100%", maxWidth: 380, border: "1px solid #2A2F38" };
const labelStyle = { display: "block", fontSize: 11.5, color: "#8B92A0", marginBottom: 4, marginTop: 10, fontWeight: 600 };
const inputStyle = { width: "100%", background: "#14171C", color: "#E8E6E1", border: "1px solid #2A2F38", borderRadius: 7, padding: "9px 10px", fontSize: 13.5, fontFamily: "inherit" };
const primaryBtn = { marginTop: 14, width: "100%", background: "#F2B705", color: "#14171C", border: "none", borderRadius: 8, padding: "11px 0", fontWeight: 600, fontSize: 14, cursor: "pointer" };

